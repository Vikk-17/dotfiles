#!/usr/bin/env bash

set -euo pipefail

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <rust-project-directory>"
    exit 1
fi

PROJECT_DIR="$1"

if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "Error: Directory '$PROJECT_DIR' does not exist."
    exit 1
fi

if [[ ! -f "$PROJECT_DIR/Cargo.toml" ]]; then
    echo "Error: '$PROJECT_DIR' is not a Rust project (Cargo.toml not found)."
    exit 1
fi

cd "$PROJECT_DIR"

run() {
    echo
    echo "===================================="
    echo "Running: $*"
    echo "===================================="
    "$@"
}

run cargo fmt --all -- --check
run cargo clippy -- -D warnings
run cargo test --release -- --test-threads=1

echo
echo "[+] All Rust quality checks passed."

